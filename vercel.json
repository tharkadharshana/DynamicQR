{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "crons": [
    { "path": "/api/cron/cleanup", "schedule": "30 21 * * *" },
    { "path": "/api/cron/digest", "schedule": "30 2 * * 1" }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/internal/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|internal|assets).*)",
      "destination": "/index.html"
    }
  ]
}
