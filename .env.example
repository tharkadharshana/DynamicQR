# DynamicQR Environment Variables Example

# --- Vercel Deployment ---
# APP_URL: The URL where the frontend is hosted (e.g., https://your-app.vercel.app)
# Used for CORS, PayHere callbacks, and QR redirects.
APP_URL="https://your-app.vercel.app"

# NODE_ENV: Set to 'production' on Vercel.
NODE_ENV="production"

# --- Security & Secrets ---
# INTERNAL_SECRET: Shared secret between the backend and Cloudflare Worker.
# Must match the secret set in the Worker.
INTERNAL_SECRET="your-long-random-secret"

# HASH_SALT: Salt used for generating visitor fingerprints and security hashes.
# Must match the secret set in the Worker.
HASH_SALT="your-random-hash-salt"

# VITE_SHORT_DOMAIN: Permanent short-link domain encoded into every dynamic QR.
# Must be the domain the Cloudflare Worker fronts. Never change it after codes are printed.
VITE_SHORT_DOMAIN="https://scnr.tharkak.com"

# --- Supabase (Frontend & Backend) ---
# VITE_SUPABASE_URL: The URL of your Supabase project
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: The public anon key for the frontend
VITE_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: The backend secret key for admin operations (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Billing (PayHere) ---
# PAYHERE_MERCHANT_ID: Your PayHere merchant ID.
PAYHERE_MERCHANT_ID="your-merchant-id"

# PAYHERE_SECRET: Your PayHere merchant secret.
PAYHERE_SECRET="your-payhere-secret"

# PAYHERE_SANDBOX: "true" sends checkouts to sandbox.payhere.lk. Charges are in LKR.
PAYHERE_SANDBOX="false"

# --- Billing (Polar, USD card payments) — optional; USD falls back to PayHere when unset ---
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_SANDBOX="false"
POLAR_PRODUCT_PRO_MONTHLY=""
POLAR_PRODUCT_PRO_ANNUAL=""
POLAR_PRODUCT_TEAM_MONTHLY=""
POLAR_PRODUCT_TEAM_ANNUAL=""
POLAR_PRODUCT_BUSINESS_MONTHLY=""
POLAR_PRODUCT_BUSINESS_ANNUAL=""
# Customer portal link shown on the Billing page for card subscribers
POLAR_PORTAL_URL=""

# --- Public business identity (shown on Landing and legal pages) ---
VITE_LEGAL_NAME="Scnr"
VITE_BUSINESS_ADDRESS="Colombo, Sri Lanka"
VITE_SUPPORT_EMAIL="support@example.com"
# Digits with country code, e.g. 94771234567. Enables WhatsApp support/setup buttons.
VITE_SUPPORT_WHATSAPP=""
VITE_SUPPORT_HOURS="Mon–Sat, 9am–6pm (Sri Lanka time)"
VITE_FOUNDER_NAME=""
# Public uptime/status page (e.g. Better Stack, UptimeRobot)
VITE_STATUS_URL=""
# A real dynamic QR slug you own, shown as the live demo on Landing
VITE_DEMO_SLUG=""

# --- Logging ---
# LOG_LEVEL: Winston logging level (error, warn, info, debug).
LOG_LEVEL="info"
